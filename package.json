{
  "name": "e-shop",
  "version": "1.0.0",
      "description": "E-Shop - Premium Electronics E-commerce Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server",
    "server": "nodemon backend/server",
    "client": "npm start --prefix frontend",
    "dev": "node scripts/port-manager.js && node scripts/setup-proxy.js && concurrently \"npm run server\" \"npm run client\"",
    "setup": "node scripts/setup-proxy.js",
    "config": "node scripts/setup-proxy.js",
    "ports": "node scripts/port-manager.js",
    "auth": "node scripts/clear-auth.js",
    "env": "node scripts/setup-env.js",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d"
  },
  "author": "Tanvir Anjum",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.1.4",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^5.10.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^5.3.0",
    "cross-env": "^7.0.3",
    "nodemon": "^2.0.4"
  }
}
